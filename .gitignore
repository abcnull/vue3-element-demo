# ========== 日志文件 ==========
# 各类包管理器和构建工具的日志文件
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ========== 依赖和系统文件 ==========
# node_modules - npm/yarn/pnpm 安装的第三方依赖库（体积大，不需要提交）
node_modules
# macOS 系统生成的文件
.DS_Store
# 构建产物目录（由 vite build 生成，不需要提交源码）
dist
dist-ssr
# 代码覆盖率报告
coverage
# 本地环境变量文件（如 .env.local，包含敏感信息）
*.local

# ========== 编辑器目录和文件 ==========
# VSCode 配置目录（但保留 extensions.json 推荐插件）
.vscode/*
!.vscode/extensions.json
# JetBrains IDE（WebStorm 等）生成的配置文件
.idea
# Visual Studio 生成的文件
*.suo
*.ntvs*
*.njsproj
*.sln
# Vim 编辑器生成的临时文件
*.sw?

# ========== TypeScript 编译产物 ==========
# TypeScript 的声明文件缓存
*.tsbuildinfo

# ========== ESLint 缓存 ==========
# ESLint 缓存文件，用于加速检查
.eslintcache

# ========== Cypress 测试文件 ==========
# Cypress E2E 测试产生的视频和截图
/cypress/videos/
/cypress/screenshots/

# ========== Vitest 测试文件 ==========
# Vitest 单元测试产生的截图
__screenshots__/

# ========== Vite 临时文件 ==========
# Vite 生成的时间戳临时文件
*.timestamp-*-*.mjs

# ========== AI 工具相关文件 ==========
# 各类 AI 编辑器/助手生成的配置和缓存目录
.trae/
.cursor/
.history/
.specs/
# 项目文档目录（如果是个人笔记或临时文档，不需要提交）
doc/
